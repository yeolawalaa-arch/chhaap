// Chhaap — database schema
//
// Canonical target is PostgreSQL. The schema is deliberately written to be
// portable (no native enums, no provider-specific attributes, JSON stored as
// text via the codecs in src/lib/db/json.ts) so `npm run db:sqlite` can mirror
// it onto SQLite for zero-infrastructure local development.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  avatarUrl     String?
  passwordHash  String? // null for OAuth-only accounts
  role          String    @default("user") // user | admin
  locale        String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime?
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  brands        Brand[]
  generations   AiGeneration[]
  subscription  Subscription?
  payments      Payment[]
  usageRecords  UsageRecord[]
  downloads     Download[]
  memberships   TeamMember[]
  ownedTeams    Team[]         @relation("TeamOwner")

  @@index([role])
  @@index([createdAt])
}

/// External identity provider link (Google, and future providers).
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // google | github | ...
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Server-side session record. The cookie holds a signed JWT whose `sid` claim
/// points here, so sessions can be revoked server-side (logout everywhere).
model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One-time tokens: email verification, password reset, and login OTP codes.
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String // email address
  tokenHash  String   @unique
  purpose    String // verify_email | reset_password | otp_login
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Teams (Business plan)
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TeamMember[]
  brands  Brand[]

  @@index([ownerId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member") // owner | admin | member | viewer
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Brand workspace
// ---------------------------------------------------------------------------

/// A brand is the top-level workspace. Everything else hangs off it.
model Brand {
  id           String   @id @default(cuid())
  userId       String
  teamId       String?
  name         String
  slug         String   @unique
  tagline      String?
  industry     String
  audience     String?
  personality  String // JSON array of personality trait ids
  colorPref    String? // JSON: { mode, seeds[] }
  language     String   @default("en")
  scriptHint   String? // devanagari | tamil | latin | ...
  status       String   @default("draft") // draft | active | archived
  isPublic     Boolean  @default(false)
  viewCount    Int      @default(0)
  briefJson    String // JSON: the full BrandBrief the user submitted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  archivedAt   DateTime?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  directions  BrandDirection[]
  identity    BrandIdentity?
  logos       Logo[]
  assets      BrandAsset[]
  generations AiGeneration[]
  downloads   Download[]

  @@index([userId, updatedAt])
  @@index([isPublic, viewCount])
  @@index([industry])
}

/// One of the candidate directions the Brand Brain proposes at step 3.
model BrandDirection {
  id         String   @id @default(cuid())
  brandId    String
  label      String
  summary    String
  specJson   String // JSON: BrandIdentitySpec
  score      Int      @default(0)
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// The single locked-in brand system. Every asset renders from this.
model BrandIdentity {
  id            String   @id @default(cuid())
  brandId       String   @unique
  specJson      String // JSON: BrandIdentitySpec — colors, type, mark, tokens
  strategyJson  String // JSON: BrandStrategy — voice, positioning, taglines
  qualityJson   String? // JSON: last QualityReport
  qualityScore  Int      @default(0)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

/// A logo variation. `docJson` is the editable LogoDocument used by the studio.
model Logo {
  id        String   @id @default(cuid())
  brandId   String
  variation String // primary | secondary | horizontal | vertical | icon | black | white | monochrome
  docJson   String // JSON: LogoDocument (layers, transforms, text, colors)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, variation])
  @@index([brandId])
}

/// A generated business asset (card, IG post, signboard, ...).
model BrandAsset {
  id         String   @id @default(cuid())
  brandId    String
  kind       String // visiting_card | letterhead | ig_post | signboard | ...
  templateId String?
  name       String
  dataJson   String // JSON: user-editable field values for the template
  widthMm    Float?
  heightMm   Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([brandId, kind])
}

/// Reusable asset template. Seeded by us today; sellable by designers later
/// (see `authorId` / `priceInr` — the marketplace hooks).
model Template {
  id          String   @id @default(cuid())
  key         String   @unique
  kind        String
  name        String
  description String?
  category    String // industry key or "universal"
  tier        String   @default("free") // free | pro | business
  configJson  String // JSON: TemplateConfig consumed by the render engine
  previewHint String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)

  // --- marketplace scaffolding (unused by the MVP, reserved for phase 2) ---
  authorId        String?
  priceInr        Int      @default(0)
  commissionBps   Int      @default(3000)
  marketplaceState String  @default("first_party") // first_party | submitted | approved | rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets BrandAsset[]

  @@index([kind, category])
  @@index([marketplaceState])
}

// ---------------------------------------------------------------------------
// AI + usage accounting
// ---------------------------------------------------------------------------

/// Audit row for every call through the AI abstraction layer, including the
/// deterministic engine, so usage limits and admin analytics are provider-agnostic.
model AiGeneration {
  id           String   @id @default(cuid())
  userId       String
  brandId      String?
  kind         String // directions | names | taglines | voice | copy
  provider     String // heuristic | anthropic | ...
  model        String?
  inputJson    String
  outputJson   String?
  status       String   @default("success") // success | error | rate_limited
  errorMessage String?
  latencyMs    Int?
  inputTokens  Int?
  outputTokens Int?
  costMicroInr Int?
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([provider])
}

/// Rolling monthly counters, one row per user per metric per period.
model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  metric    String // ai_generation | brand | export_hires | export_vector
  period    String // YYYY-MM
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, period])
  @@index([period])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  kind      String // brand_kit | logo_pack | asset
  format    String // svg | png | jpg | pdf | zip
  detail    String?
  watermark Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

/// Plans are rows, not constants, so the admin can retune limits and pricing
/// without a deploy.
model Plan {
  id           String   @id @default(cuid())
  key          String   @unique // free | pro | business
  name         String
  description  String?
  priceInr     Int      @default(0) // paise-free rupees, monthly
  priceInrYear Int      @default(0)
  currency     String   @default("INR")
  limitsJson   String // JSON: PlanLimits
  featuresJson String // JSON: string[] shown on the pricing page
  isActive     Boolean  @default(true)
  isPopular    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String   @unique
  planId             String
  status             String   @default("active") // active | past_due | canceled | trialing
  gateway            String? // razorpay | stripe | manual
  gatewaySubId       String?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId, status])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  amountInr     Int
  currency      String   @default("INR")
  status        String // created | paid | failed | refunded
  gateway       String
  gatewayOrderId String?
  gatewayPayId  String?
  signature     String?
  couponCode    String?
  metaJson      String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  percentOff    Int?
  amountOffInr  Int?
  maxRedemptions Int?
  redemptions   Int      @default(0)
  appliesToPlan String?
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Content & growth
// ---------------------------------------------------------------------------

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String // markdown
  coverHint   String?
  tags        String // JSON string[]
  authorName  String   @default("Chhaap")
  readMinutes Int      @default(5)
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

/// Curated entries for the public gallery at /showcase.
model ShowcaseEntry {
  id         String   @id @default(cuid())
  brandId    String   @unique
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  approvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([isFeatured, sortOrder])
}

/// Simple key/value store for admin-tunable platform settings.
model Setting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

/// Fixed-window rate limit buckets. Swappable for Redis via the same interface
/// in src/lib/security/rate-limit.ts.
model RateLimit {
  id        String   @id @default(cuid())
  bucket    String   @unique
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
