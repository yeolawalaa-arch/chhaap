# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fonts are fetched by `npm run fonts:fetch`, not committed (11 MB of binaries).
# The Vercel build runs the fetch, so production has them.
/public/fonts/*.ttf
/public/fonts/fonts.css

# Local preview scratch
/public/_preview

# Generated SQLite mirror + local db
/prisma/schema.sqlite.prisma
/prisma/dev.db
/prisma/dev.db-journal
